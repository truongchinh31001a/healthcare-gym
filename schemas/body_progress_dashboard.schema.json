{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BodyProgressDashboard-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "as_of",
    "report_timezone",
    "synthetic_only",
    "series",
    "quality_summary",
    "interpolated_values",
    "clinical_interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "subject_id": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "report_timezone": {
      "type": "string"
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stream_id",
          "subject_id",
          "field",
          "provenance",
          "verification_band",
          "unit",
          "days",
          "trend"
        ],
        "properties": {
          "stream_id": {
            "type": "string"
          },
          "subject_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "observed",
              "declared",
              "extracted",
              "inferred"
            ]
          },
          "unit": {
            "type": "string"
          },
          "verification_band": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "day",
                "value",
                "observation_ids",
                "flags"
              ],
              "properties": {
                "day": {
                  "type": "string",
                  "format": "date"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "observation_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "trend": {
            "type": "object",
            "required": [
              "status",
              "slope_per_week",
              "withheld_reasons",
              "statistical_confidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "withheld",
                  "descriptive_only"
                ]
              },
              "slope_per_week": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "withheld_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "statistical_confidence": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    "quality_summary": {
      "type": "object"
    },
    "interpolated_values": {
      "const": false
    },
    "clinical_interpretation": {
      "const": false
    }
  }
}
