# Local development only. Copy the API values into apps/api/.env when running outside Docker.
ENVIRONMENT=development
DATABASE_URL=sqlite+pysqlite:///./health.db
STORAGE_DIR=./private-storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside development. Back up the key separately; losing it loses encrypted data.
ENCRYPTION_KEY=
SESSION_HOURS=12
DOCUMENT_RETENTION_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
POSTGRES_DB=health_assistant
POSTGRES_USER=health
POSTGRES_PASSWORD=local-development-only
# Next.js server-side API proxy, not a browser public variable.
API_INTERNAL_URL=http://127.0.0.1:8000
# Mobile .env: Android emulator uses http://10.0.2.2:8000 by default.
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000
